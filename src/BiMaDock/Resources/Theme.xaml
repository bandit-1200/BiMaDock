<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:BiMaDock.Views">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Farben. Die Dock-Farben werden zur Laufzeit von ThemeService aus den Einstellungen gesetzt;
         hier stehen nur die Standardwerte. Deshalb überall DynamicResource. -->
    <SolidColorBrush x:Key="DockSurfaceBrush" Color="#EB2A2A30" />
    <SolidColorBrush x:Key="LiquidBrush" Color="#EB2A2A30" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#404CC2FF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F2FFFFFF" />
    <Visibility x:Key="LabelVisibility">Collapsed</Visibility>

    <!-- Fläche von Haupt- und Kategorie-Dock -->
    <Style x:Key="DockSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DockSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ein Symbol im Dock -->
    <Style x:Key="DockItemButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="64" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
        <Setter Property="ToolTipService.Placement" Value="Bottom" />
        <Setter Property="views:ItemAnimations.Enabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent">
                        <Grid x:Name="IconArea" Height="64">
                            <Border x:Name="HoverPlate" CornerRadius="12" Margin="3" Opacity="0"
                                    Background="{StaticResource HoverBrush}" />
                            <Border x:Name="DropPlate" CornerRadius="12" Margin="3" Visibility="Collapsed"
                                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" />
                            <Image x:Name="IconImage" Source="{Binding Icon}" Width="44" Height="44"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Ellipse x:Name="OpenMarker" Width="5" Height="5" Margin="0,0,0,1"
                                     VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" Visibility="{DynamicResource LabelVisibility}"
                                   Foreground="{StaticResource ForegroundBrush}" FontSize="11" Margin="1,-4,1,2"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.9" Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter TargetName="OpenMarker" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Background" Value="#33FFFFFF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="DropPlate" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="IconImage" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kontextmenü im Dock-Design -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#F2242429" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="4" Margin="0,0,8,8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.4" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Plate" CornerRadius="6" Padding="12,6" Background="Transparent" MinWidth="180">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#2EFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Trennlinie in Menüs (WPF verwendet dort einen eigenen Stilschlüssel) -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="#26FFFFFF" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="#26FFFFFF" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eingabefelder und Schaltflächen für Dialoge -->
    <!-- Rahmen aller Dialoge -->
    <Style x:Key="DialogFrameStyle" TargetType="Border">
        <Setter Property="Margin" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#FF242429" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#B3FFFFFF" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <Style x:Key="DialogCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                BorderBrush="#66FFFFFF" Background="#1AFFFFFF" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M3,9 L7,13 L15,4" Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="#FF2A7FB8" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FF2A7FB8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogSliderStyle" TargetType="Slider">
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,6">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,7">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Plate" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="Background" Value="#FF2A7FB8" />
    </Style>

    <!-- Tabs im Einstellungsfenster -->
    <Style x:Key="DialogTabControlStyle" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#B3FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent" Margin="0,0,4,0">
                        <ContentPresenter ContentSource="Header" Margin="14,8,14,10" />
                        <Border x:Name="Underline" Height="2.5" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="10,0"
                                Background="{DynamicResource AccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogSectionStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Margin" Value="0,18,0,0" />
    </Style>

    <Style x:Key="DialogHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#80FFFFFF" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Schmale dunkle Scrollbalken -->
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Background="#4DFFFFFF" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#80FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="1,2" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F2242429" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
