<Window x:Class="BiMaDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BiMaDock.ViewModels"
        xmlns:views="clr-namespace:BiMaDock.Views"
        Title="BiMaDock"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Left="0" Top="0" Height="320"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="DockItemTemplate" DataType="{x:Type vm:DockItemViewModel}">
            <Button Style="{StaticResource DockItemButtonStyle}"
                    ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}"
                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Item_PreviewMouseMove">
                <Button.ContextMenu>
                    <ContextMenu Opened="Menu_Opened">
                        <MenuItem Header="Öffnen" Click="ItemOpen_Click" FontWeight="SemiBold"
                                  Visibility="{Binding IsItem, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Als Administrator starten" Click="ItemRunAsAdmin_Click"
                                  Visibility="{Binding AcceptsFiles, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Im Explorer zeigen" Click="ItemReveal_Click"
                                  Visibility="{Binding CanReveal, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Bearbeiten …" Click="ItemEdit_Click"
                                  Visibility="{Binding IsItem, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Entfernen" Click="ItemRemove_Click" />
                        <MenuItem Header="Trenner rechts einfügen" Click="ItemInsertSeparator_Click" />
                        <Separator />
                        <MenuItem Header="Neue Kategorie …" Click="NewCategory_Click" />
                        <MenuItem Header="Aufräumen …" Click="Cleanup_Click" />
                        <MenuItem Header="Symbolbibliothek …" Click="IconLibrary_Click" />
                        <MenuItem Tag="Undo" Header="Rückgängig" Click="Undo_Click" />
                        <Separator />
                        <MenuItem Header="Einstellungen …" Click="Settings_Click" />
                        <MenuItem Header="Nach Updates suchen …" Click="CheckUpdates_Click" />
                        <MenuItem Header="Datenordner öffnen" Click="OpenDataFolder_Click" />
                        <MenuItem Header="Über BiMaDock …" Click="About_Click" />
                        <MenuItem Header="Beenden" Click="Exit_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <!-- Pfeil zum Scrollen, wenn die Leiste breiter als der Bildschirm ist -->
        <Style x:Key="DockScrollArrowStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="10" Margin="1,6">
                            <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{StaticResource ForegroundBrush}"
                                  StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Durchsichtige Bereiche (Background = null) lassen Mausklicks zu den Fenstern dahinter durch. -->
    <Grid x:Name="Root">
        <Grid x:Name="DockArea" VerticalAlignment="Top" HorizontalAlignment="Center"
              Background="#01000000" AllowDrop="True"
              MouseEnter="DockArea_MouseEnter" MouseLeave="DockArea_MouseLeave"
              ContextMenuOpening="DockArea_ContextMenuOpening" ContextMenuClosing="DockArea_ContextMenuClosing"
              DragEnter="DockArea_DragEnter" DragOver="DockArea_DragOver"
              DragLeave="DockArea_DragLeave" Drop="DockArea_Drop">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Flüssigkeit, aus der das Kategorie-Dock entsteht (liegt hinter dem Hauptdock) -->
            <views:LiquidFlow x:Name="Liquid" Grid.RowSpan="2" Panel.ZIndex="0" Fill="{DynamicResource LiquidBrush}" />

            <!-- Kategorie-Dock: erscheint, sobald die Flüssigkeit seine Form angenommen hat -->
            <!-- Fläche und Schatten des Kategorie-Docks als eigenes, leeres Element: Der Schatten wird so nicht bei
                 jeder Bewegung der Symbole mit dem ganzen Inhalt neu berechnet. -->
            <views:SoftShadow Grid.Row="1" Panel.ZIndex="1" CornerRadius="18"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,14"
                    Width="{Binding ActualWidth, ElementName=CategoryDock}" Height="{Binding ActualHeight, ElementName=CategoryDock}"
                    Visibility="{Binding Visibility, ElementName=CategoryDock}" Opacity="{Binding Opacity, ElementName=CategoryDock}"
                    RenderTransform="{Binding RenderTransform, ElementName=CategoryDock}" />
            <Border x:Name="CategorySurface" Grid.Row="1" Panel.ZIndex="1" Style="{StaticResource DockSurfaceStyle}" Effect="{x:Null}"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,14" IsHitTestVisible="False"
                    Width="{Binding ActualWidth, ElementName=CategoryDock}" Height="{Binding ActualHeight, ElementName=CategoryDock}"
                    Visibility="{Binding Visibility, ElementName=CategoryDock}" Opacity="{Binding Opacity, ElementName=CategoryDock}"
                    RenderTransform="{Binding RenderTransform, ElementName=CategoryDock}" />
            <Border x:Name="CategoryDock" Grid.Row="1" Panel.ZIndex="1" Style="{StaticResource DockSurfaceStyle}"
                    Background="Transparent" BorderBrush="Transparent" Effect="{x:Null}" VerticalAlignment="Top"
                    HorizontalAlignment="Center" Margin="0,24,0,14" Visibility="Collapsed" MinWidth="72">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CategoryOffset" />
                </Border.RenderTransform>
                <Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CategoryScrollLeft" Style="{StaticResource DockScrollArrowStyle}" Content="M6,0 L0,6 L6,12" Visibility="Collapsed" />
                        <views:DockScrollPanel x:Name="CategoryScroll" Grid.Column="1">
    <ItemsControl x:Name="CategoryItemsControl" UseLayoutRounding="False" ItemsSource="{Binding CategoryItems}"
                                  ItemTemplate="{StaticResource DockItemTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" />
                        </views:DockScrollPanel>
                        <Button x:Name="CategoryScrollRight" Grid.Column="2" Style="{StaticResource DockScrollArrowStyle}" Content="M0,0 L6,6 L0,12" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="EmptyCategoryHint" Text="Elemente hierher ziehen" Margin="16,22"
                               Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Hauptdock -->
            <views:SoftShadow Panel.ZIndex="2" CornerRadius="0,0,18,18" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="{Binding ActualWidth, ElementName=MainDock}" Height="{Binding ActualHeight, ElementName=MainDock}" />
            <Border x:Name="MainSurface" Panel.ZIndex="2" Style="{StaticResource DockSurfaceStyle}" Effect="{x:Null}"
                    CornerRadius="0,0,18,18" BorderThickness="1,0,1,1" HorizontalAlignment="Center" VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Width="{Binding ActualWidth, ElementName=MainDock}" Height="{Binding ActualHeight, ElementName=MainDock}" />
            <Border x:Name="MainDock" Panel.ZIndex="2" Style="{StaticResource DockSurfaceStyle}"
                    Background="Transparent" BorderBrush="Transparent" Effect="{x:Null}" VerticalAlignment="Top"
                    CornerRadius="0,0,18,18" BorderThickness="1,0,1,1" HorizontalAlignment="Center"
                    MinWidth="120" MinHeight="40">
                <Border.ContextMenu>
                    <ContextMenu Opened="Menu_Opened">
                        <MenuItem Header="Neue Kategorie …" Click="NewCategory_Click" />
                        <MenuItem Header="Aufräumen …" Click="Cleanup_Click" />
                        <MenuItem Header="Symbolbibliothek …" Click="IconLibrary_Click" />
                        <MenuItem Tag="Undo" Header="Rückgängig" Click="Undo_Click" />
                        <Separator />
                        <MenuItem Header="Einstellungen …" Click="Settings_Click" />
                        <MenuItem Header="Nach Updates suchen …" Click="CheckUpdates_Click" />
                        <MenuItem Header="Datenordner öffnen" Click="OpenDataFolder_Click" />
                        <MenuItem Header="Über BiMaDock …" Click="About_Click" />
                        <MenuItem Header="Beenden" Click="Exit_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MainScrollLeft" Style="{StaticResource DockScrollArrowStyle}" Content="M6,0 L0,6 L6,12" Visibility="Collapsed" />
                        <views:DockScrollPanel x:Name="MainScroll" Grid.Column="1">
    <ItemsControl x:Name="MainItemsControl" UseLayoutRounding="False" ItemsSource="{Binding MainItems}"
                                  ItemTemplate="{StaticResource DockItemTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" />
                        </views:DockScrollPanel>
                        <Button x:Name="MainScrollRight" Grid.Column="2" Style="{StaticResource DockScrollArrowStyle}" Content="M0,0 L6,6 L0,12" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="EmptyMainHint" Text="Programme, Dateien oder Links hierher ziehen" Margin="16,22"
                               Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
