<Window x:Class="BiMaDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BiMaDock.ViewModels"
        xmlns:views="clr-namespace:BiMaDock.Views"
        Title="BiMaDock"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Left="0" Top="0" Height="320"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="DockItemTemplate" DataType="{x:Type vm:DockItemViewModel}">
            <Button Style="{StaticResource DockItemButtonStyle}"
                    ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}"
                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Item_PreviewMouseMove">
                <Button.ContextMenu>
                    <ContextMenu Opened="Menu_Opened">
                        <MenuItem Header="Öffnen" Click="ItemOpen_Click" FontWeight="SemiBold" />
                        <MenuItem Header="Im Explorer zeigen" Click="ItemReveal_Click"
                                  Visibility="{Binding CanReveal, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Bearbeiten …" Click="ItemEdit_Click" />
                        <MenuItem Header="Entfernen" Click="ItemRemove_Click" />
                        <Separator />
                        <MenuItem Header="Neue Kategorie …" Click="NewCategory_Click" />
                        <MenuItem Header="Aufräumen …" Click="Cleanup_Click" />
                        <MenuItem Header="Symbolbibliothek …" Click="IconLibrary_Click" />
                        <MenuItem Tag="Undo" Header="Rückgängig" Click="Undo_Click" />
                        <Separator />
                        <MenuItem Header="Einstellungen …" Click="Settings_Click" />
                        <MenuItem Header="Nach Updates suchen …" Click="CheckUpdates_Click" />
                        <MenuItem Header="Datenordner öffnen" Click="OpenDataFolder_Click" />
                        <MenuItem Header="Über BiMaDock …" Click="About_Click" />
                        <MenuItem Header="Beenden" Click="Exit_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- Durchsichtige Bereiche (Background = null) lassen Mausklicks zu den Fenstern dahinter durch. -->
    <Grid x:Name="Root">
        <Grid x:Name="DockArea" VerticalAlignment="Top" HorizontalAlignment="Center"
              Background="#01000000" AllowDrop="True"
              MouseEnter="DockArea_MouseEnter" MouseLeave="DockArea_MouseLeave"
              ContextMenuOpening="DockArea_ContextMenuOpening" ContextMenuClosing="DockArea_ContextMenuClosing"
              DragEnter="DockArea_DragEnter" DragOver="DockArea_DragOver"
              DragLeave="DockArea_DragLeave" Drop="DockArea_Drop">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Flüssigkeit, aus der das Kategorie-Dock entsteht (liegt hinter dem Hauptdock) -->
            <views:LiquidFlow x:Name="Liquid" Grid.RowSpan="2" Panel.ZIndex="0" Fill="{DynamicResource LiquidBrush}" />

            <!-- Kategorie-Dock: erscheint, sobald die Flüssigkeit seine Form angenommen hat -->
            <Border x:Name="CategoryDock" Grid.Row="1" Panel.ZIndex="1" Style="{StaticResource DockSurfaceStyle}"
                    HorizontalAlignment="Center" Margin="0,24,0,14" Visibility="Collapsed" MinWidth="72">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CategoryOffset" />
                </Border.RenderTransform>
                <Grid>
                    <ItemsControl x:Name="CategoryItemsControl" ItemsSource="{Binding CategoryItems}"
                                  ItemTemplate="{StaticResource DockItemTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" />
                    <TextBlock x:Name="EmptyCategoryHint" Text="Elemente hierher ziehen" Margin="16,22"
                               Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Hauptdock -->
            <Border x:Name="MainDock" Panel.ZIndex="2" Style="{StaticResource DockSurfaceStyle}"
                    CornerRadius="0,0,18,18" BorderThickness="1,0,1,1" HorizontalAlignment="Center"
                    MinWidth="120" MinHeight="40">
                <Border.ContextMenu>
                    <ContextMenu Opened="Menu_Opened">
                        <MenuItem Header="Neue Kategorie …" Click="NewCategory_Click" />
                        <MenuItem Header="Aufräumen …" Click="Cleanup_Click" />
                        <MenuItem Header="Symbolbibliothek …" Click="IconLibrary_Click" />
                        <MenuItem Tag="Undo" Header="Rückgängig" Click="Undo_Click" />
                        <Separator />
                        <MenuItem Header="Einstellungen …" Click="Settings_Click" />
                        <MenuItem Header="Nach Updates suchen …" Click="CheckUpdates_Click" />
                        <MenuItem Header="Datenordner öffnen" Click="OpenDataFolder_Click" />
                        <MenuItem Header="Über BiMaDock …" Click="About_Click" />
                        <MenuItem Header="Beenden" Click="Exit_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <ItemsControl x:Name="MainItemsControl" ItemsSource="{Binding MainItems}"
                                  ItemTemplate="{StaticResource DockItemTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" />
                    <TextBlock x:Name="EmptyMainHint" Text="Programme, Dateien oder Links hierher ziehen" Margin="16,22"
                               Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
