<views:DialogWindow x:Class="BiMaDock.Views.CleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BiMaDock.Views"
        Title="Aufräumen" Width="560">
    <Border Style="{StaticResource DialogFrameStyle}">
        <StackPanel>
            <TextBlock Text="Aufräumen" Style="{StaticResource DialogTitleStyle}" Margin="0,0,0,4" />
            <TextBlock x:Name="Summary" Foreground="#B3FFFFFF" TextWrapping="Wrap" Margin="0,0,0,12" />

            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CandidateList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type views:CleanupRow}">
                            <Border Padding="8,6" Margin="0,2" CornerRadius="8" Background="#0FFFFFFF">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource DialogCheckBoxStyle}"
                                              Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" DockPanel.Dock="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Vor dem Entfernen wird gesichert; „Rückgängig“ im Kontextmenü stellt alles wieder her."
                       Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="RemoveButton" Content="Entfernen" IsDefault="True" Style="{StaticResource AccentDialogButtonStyle}" Click="Remove_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</views:DialogWindow>
