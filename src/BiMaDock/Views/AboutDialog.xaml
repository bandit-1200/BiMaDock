<views:DialogWindow x:Class="BiMaDock.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BiMaDock.Views"
        Title="Über BiMaDock" Width="400">
    <Border Style="{StaticResource DialogFrameStyle}">
        <StackPanel>
            <TextBlock Text="BiMaDock" Style="{StaticResource DialogTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" Style="{StaticResource DialogHintStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock Text="Die Dock-Leiste, die Windows gefehlt hat: Programme, Dateien, Ordner und Weblinks mit einem Klick."
                       Style="{StaticResource DialogHintStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="Entwickler: Marco Bilz" Style="{StaticResource DialogLabelStyle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource DialogLabelStyle}" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Run Text="Lizenz: " />
                <Hyperlink NavigateUri="https://github.com/bandit-1200/BiMaDock/blob/main/LICENSE" RequestNavigate="Link_RequestNavigate">MIT</Hyperlink>
            </TextBlock>
            <TextBlock Style="{StaticResource DialogLabelStyle}" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Hyperlink NavigateUri="https://github.com/bandit-1200/BiMaDock" RequestNavigate="Link_RequestNavigate">github.com/bandit-1200/BiMaDock</Hyperlink>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Content="OK" IsDefault="True" IsCancel="True" Style="{StaticResource AccentDialogButtonStyle}" Margin="0" />
            </StackPanel>
        </StackPanel>
    </Border>
</views:DialogWindow>
