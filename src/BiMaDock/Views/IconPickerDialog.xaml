<views:DialogWindow x:Class="BiMaDock.Views.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BiMaDock.Views"
        Title="Symbolbibliothek" Width="760">
    <Border Style="{StaticResource DialogFrameStyle}">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Symbolbibliothek" Style="{StaticResource DialogTitleStyle}" />

            <TextBox x:Name="SearchBox" Style="{StaticResource DialogTextBoxStyle}" TextChanged="Filter_Changed"
                     ToolTip="Nach Namen suchen" />
            <WrapPanel x:Name="CategoryPanel" Margin="0,10,0,4" />

            <Border CornerRadius="8" Background="#18FFFFFF" Margin="0,6,0,0">
                <ScrollViewer Height="380" VerticalScrollBarVisibility="Auto" Padding="6">
                    <WrapPanel x:Name="IconPanel" />
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="StatusText" Foreground="#80FFFFFF" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Eigene Symbole kannst du mit „Hinzufügen …“ übernehmen oder einfach hierher ziehen." />

            <DockPanel Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Hinzufügen …" Style="{StaticResource DialogButtonStyle}" Click="Import_Click" />
                    <Button x:Name="DeleteButton" Content="Entfernen" Style="{StaticResource DialogButtonStyle}" Click="Delete_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Abbrechen" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
                    <Button x:Name="ChooseButton" Content="Übernehmen" IsDefault="True" Style="{StaticResource AccentDialogButtonStyle}"
                            Click="Choose_Click" IsEnabled="False" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</views:DialogWindow>
