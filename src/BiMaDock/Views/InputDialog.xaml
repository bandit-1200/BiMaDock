<Window x:Class="BiMaDock.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BiMaDock" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Border Margin="16" CornerRadius="12" Background="#FF242429" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
            Padding="20" MouseLeftButtonDown="Frame_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock x:Name="PromptText" Margin="0,6,0,12" Foreground="#B3FFFFFF" TextWrapping="Wrap" />
            <TextBox x:Name="InputBox" Style="{StaticResource DialogTextBoxStyle}" TextChanged="InputBox_TextChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
                <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource AccentDialogButtonStyle}" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
