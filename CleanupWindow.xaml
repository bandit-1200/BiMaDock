<Window x:Class="BiMaDock.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock aufräumen" Width="620"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">
    <Border Style="{DynamicResource DialogSurfaceBorderStyle}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Dock aufräumen" Style="{DynamicResource DialogTitleTextStyle}" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="1" x:Name="SummaryText" Style="{DynamicResource DialogBodyTextStyle}" Margin="0,0,0,14"/>

            <ScrollViewer Grid.Row="2" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CandidateList" AutomationProperties.AutomationId="CleanupCandidateList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#26282D" BorderBrush="{DynamicResource DialogBorderColor}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{Binding DisplayName}"
                                          AutomationProperties.AutomationId="{Binding AutomationId}"
                                          VerticalContentAlignment="Center"
                                          HorizontalContentAlignment="Stretch"
                                          Foreground="{DynamicResource ForegroundColor}"
                                          Cursor="Hand">
                                    <Grid Margin="8,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource ForegroundColor}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="12" Foreground="{DynamicResource DialogMutedColor}" Opacity="0.75" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" FontSize="12" Foreground="{DynamicResource DialogMutedColor}" Opacity="0.8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DialogMutedColor}"/>
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHint}" Value="True">
                                                                <Setter Property="Foreground" Value="#E0B252"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="SelectAllButton" Content="Alle auswählen" Style="{DynamicResource DialogSecondaryButtonStyle}" Margin="0" MinWidth="0" AutomationProperties.AutomationId="SelectAllButton" Click="SelectAllButton_Click"/>
                    <Button x:Name="SelectNoneButton" Content="Keine auswählen" Style="{DynamicResource DialogSecondaryButtonStyle}" MinWidth="0" AutomationProperties.AutomationId="SelectNoneButton" Click="SelectNoneButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RemoveSelectedButton" Content="Ausgewählte entfernen" Style="{DynamicResource DialogPrimaryButtonStyle}" MinWidth="0" AutomationProperties.AutomationId="RemoveSelectedButton" Click="RemoveSelectedButton_Click"/>
                    <Button x:Name="CancelButton" Content="Abbrechen" Style="{DynamicResource DialogSecondaryButtonStyle}" MinWidth="0" IsCancel="True" AutomationProperties.AutomationId="CancelButton" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
