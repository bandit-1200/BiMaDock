<Window x:Class="BiMaDock.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategorie erstellen" Height="250" Width="420"
        Background="#101214"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False">
    <Border Background="#1E1F23" BorderBrush="#3A3D42" BorderThickness="1" CornerRadius="18" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="QuestionTextBlock" Text="Bitte geben Sie den Namen der Kategorie ein:"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <TextBox x:Name="CategoryNameTextBox" Grid.Row="1"
                     Width="300" Margin="0,0,0,20"
                     Background="#2A2C31"
                     Foreground="White"
                     BorderBrush="#3A3D42"
                     BorderThickness="1"
                     Padding="10,8"
                     VerticalContentAlignment="Center"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="120" Click="OkButton_Click" Margin="8,0,0,0" Background="#0078D4" Foreground="White" BorderBrush="#0078D4" BorderThickness="1" Height="42"/>
                <Button Content="Abbrechen" Width="120" Click="CancelButton_Click" Margin="8,0,0,0" Background="#2A2C31" Foreground="White" BorderBrush="#3A3D42" BorderThickness="1" Height="42"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
