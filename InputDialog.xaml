<Window x:Class="BiMaDock.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Kategorie erstellen" Width="460"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">
    <Window.Resources>
        <!-- Eingabefeld im dunklen Dialogstil -->
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2C31"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5E66"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Style="{DynamicResource DialogSurfaceBorderStyle}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title, ElementName=Root}" Style="{DynamicResource DialogTitleTextStyle}" Margin="0,0,0,10"/>

            <TextBlock x:Name="QuestionTextBlock" Grid.Row="1" Text="Bitte geben Sie den Namen der Kategorie ein:"
                       Style="{DynamicResource DialogBodyTextStyle}"
                       Margin="0,0,0,12"/>

            <TextBox x:Name="CategoryNameTextBox" Grid.Row="2"
                     Style="{StaticResource DialogTextBoxStyle}"
                     Margin="0,0,0,20"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Style="{DynamicResource DialogPrimaryButtonStyle}" Click="OkButton_Click"/>
                <Button Content="Abbrechen" Style="{DynamicResource DialogSecondaryButtonStyle}" IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
