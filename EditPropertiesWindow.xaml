<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="BiMaDock.EditPropertiesWindow"
        Title="Eigenschaften bearbeiten" Width="820"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="Transparent">
    <Window.Resources>
        <!-- Beschriftung links neben den Eingabefeldern -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DialogMutedColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <!-- Kleine Beschriftung unter den Symbolvorschauen -->
        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DialogMutedColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Abgerundete Eingabefelder im dunklen Dialogstil -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="Background" Value="#26282D"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#202226"/>
                                <Setter Property="Foreground" Value="{DynamicResource DialogMutedColor}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{DynamicResource DialogSurfaceBorderStyle}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Eigenschaften bearbeiten" Style="{DynamicResource DialogTitleTextStyle}" Margin="0,0,0,18"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bildvorschau (links): ausgewähltes Symbol und Originalsymbol der Datei -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Top">
                    <Border x:Name="SelectedIconBorder" Width="80" Height="80" Background="#26282D" BorderBrush="{DynamicResource AccentColor}" BorderThickness="2" CornerRadius="12">
                        <Image x:Name="SelectedIconImage" Width="58" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ausgewählt" Style="{StaticResource CaptionTextStyle}"/>

                    <Border x:Name="OriginalImageBorder" Width="80" Height="80" Margin="0,14,0,0" Background="#26282D" BorderBrush="{DynamicResource DialogBorderColor}" BorderThickness="1" CornerRadius="12" ToolTip="Originalsymbol wiederherstellen" MouseLeftButtonDown="SuppressWindowDrag_MouseLeftButtonDown">
                        <Image x:Name="OriginalImage" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Original" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>

                <!-- Eingabefelder und Beschriftungen (rechts) -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ID -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,16,10"/>
                    <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" FontSize="11" IsReadOnly="True" IsEnabled="False" Text=""/>

                    <!-- Name -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,16,10"/>
                    <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" FontSize="14"/>

                    <!-- Kategorie -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Kategorie:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,16,10"/>
                    <TextBox x:Name="CategoryTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" IsReadOnly="True" IsEnabled="False"/>

                    <!-- Ist Kategorie -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Kategorie-Element:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,16,10"/>
                    <TextBox x:Name="IsCategoryTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" IsReadOnly="True" IsEnabled="False"/>

                    <!-- Symbolpfad -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Symbolpfad:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,16,10"/>
                    <TextBox x:Name="IconSourceTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" FontSize="12" IsReadOnly="True"/>

                    <!-- Applikationspfad -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Applikationspfad:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="ApplicationPathTextBox" Grid.Row="5" Grid.Column="1" FontSize="12" IsReadOnly="False"/>
                </Grid>
            </Grid>

            <!-- Symbolauswahl -->
            <TextBlock Grid.Row="2" Text="Symbol auswählen" Style="{DynamicResource DialogBodyTextStyle}" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <Border Grid.Row="3" Background="#26282D" BorderBrush="{DynamicResource DialogBorderColor}" BorderThickness="1" CornerRadius="12" Padding="6">
                <!-- Feste Höhe, damit das Fenster beim asynchronen Laden der Symbole nicht springt -->
                <ScrollViewer x:Name="ScrollViewerSymbolPanel" Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MouseLeftButtonDown="SuppressWindowDrag_MouseLeftButtonDown">
                    <WrapPanel x:Name="SymbolPanel" Orientation="Horizontal" Background="Transparent"/>
                </ScrollViewer>
            </Border>

            <!-- Buttons (unten) -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hochladen" Click="UploadIcon_Click" Style="{DynamicResource DialogSecondaryButtonStyle}" Margin="0" ToolTip="Eigenes PNG-Symbol hinzufügen"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Speichern" x:Name="SaveButton" Click="SaveButton_Click" Style="{DynamicResource DialogPrimaryButtonStyle}"/>
                    <Button Content="Abbrechen" Click="CancelButton_Click" Style="{DynamicResource DialogSecondaryButtonStyle}" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
