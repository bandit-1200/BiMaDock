<Window x:Class="BiMaDock.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update verfügbar" Height="300" Width="440"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <Border Style="{StaticResource DialogSurfaceBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <TextBlock Text="BiMaDock" Style="{StaticResource DialogTitleTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="UpdateMessage" Style="{StaticResource DialogBodyTextStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="DownloadButton" Content="Download" Style="{StaticResource DialogPrimaryButtonStyle}" Width="160" Click="DownloadButton_Click"/>
                <Button x:Name="CancelButton" Content="Später" Style="{StaticResource DialogSecondaryButtonStyle}" Width="140" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
