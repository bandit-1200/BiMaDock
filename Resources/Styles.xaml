<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Farben -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#1C1C1E"/> <!-- Dunkles Grau für Hintergrund -->
    <SolidColorBrush x:Key="SecondaryColor" Color="#2C2C2E"/> <!-- Helleres Grau für Sekundärflächen -->
    <SolidColorBrush x:Key="AccentColor" Color="#0078D4"/> <!-- Akzentfarbe im Windows-Stil -->
    <SolidColorBrush x:Key="ForegroundColor" Color="#FFFFFF"/> <!-- Weiß für Text -->
    <SolidColorBrush x:Key="HighlightColor" Color="#3E3E3E"/> <!-- Dunklerer Grauton für Hover- und Auswahlzustände -->
    <SolidColorBrush x:Key="DebugColor4" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="FeedbackColor" Color="#14670a"/>
    <SolidColorBrush x:Key="DialogSurfaceColor" Color="#1E1F23"/>
    <SolidColorBrush x:Key="DialogBorderColor" Color="#3A3D42"/>
    <SolidColorBrush x:Key="DialogMutedColor" Color="#D2D5DA"/>


    <!-- Stile und Templates -->
    <Style x:Key="DialogWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DialogSurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DialogSurfaceColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.45" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DialogBodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DialogMutedColor}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0F5FBF"/>
                <Setter Property="BorderBrush" Value="#0F5FBF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#0A4E9A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#2A2C31"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3A3D42"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#2F3136"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Stile und Templates -->
    <Style x:Key="MainDockStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="CategoryDockStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DockNavigationButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="#D9FFFFFF"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTip" Value="Dock-Inhalte blättern"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverWell"
                                Width="34" Height="34"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#22FFFFFF"
                                CornerRadius="9"
                                Opacity="0"/>
                        <Path x:Name="Chevron"
                              Width="20" Height="20"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 15 4 L 5 10 L 15 16"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Right">
                            <Setter TargetName="Chevron" Property="Data" Value="M 4 5 L 12 10 L 4 15"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverWell" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverWell" Property="Background" Value="#38FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chevron" Property="Opacity" Value="0.28"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separator-Stil -->
    <Style TargetType="Separator">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="10,5,10,5"/>
        <Setter Property="Background" Value="{DynamicResource HighlightColor}"/>
    </Style>

    <!-- Button-Stil für einen subtilen Look -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SecondaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFFFFF"/> <!-- Dunklere Akzentfarbe beim Drücken -->
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
