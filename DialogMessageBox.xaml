<Window x:Class="BiMaDock.DialogMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BiMaDock"
        SizeToContent="WidthAndHeight"
        MinWidth="384"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">
    <Border Style="{DynamicResource DialogSurfaceBorderStyle}" Margin="12" MaxWidth="520">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconGlyph" Grid.Column="0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="CaptionTextBlock" Grid.Column="1"
                           Style="{DynamicResource DialogTitleTextStyle}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="420" Margin="0,0,0,22"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <TextBlock x:Name="MessageTextBlock" Style="{DynamicResource DialogBodyTextStyle}"/>
            </ScrollViewer>

            <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
