<Window x:Class="BiMaDock.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über BiMaDock" Width="520"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">
    <Border Style="{DynamicResource DialogSurfaceBorderStyle}" Margin="12">
        <StackPanel>
            <TextBlock Text="BiMaDock" Style="{DynamicResource DialogTitleTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="VersionTextBox" Style="{DynamicResource DialogBodyTextStyle}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Autor: Marco Bilz" Style="{DynamicResource DialogBodyTextStyle}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock Text="BiMaDock ist eine WPF-basierte Anwendung für Windows, die eine personalisierbare Dock-Leiste zur Organisation von Programmen und Dateien bietet."
                       Style="{DynamicResource DialogBodyTextStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock HorizontalAlignment="Center" Style="{DynamicResource DialogBodyTextStyle}" Margin="0,0,0,8">
                <Run Text="Lizenz: " />
                <Hyperlink NavigateUri="https://opensource.org/licenses/MIT" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#4CA3F0">
                    MIT
                </Hyperlink>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Auf Update prüfen" Style="{DynamicResource DialogPrimaryButtonStyle}" Click="CheckUpdateButton_Click"/>
                <Button Content="Schließen" Style="{DynamicResource DialogSecondaryButtonStyle}" IsCancel="True" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
