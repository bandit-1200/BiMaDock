<Window x:Class="BiMaDock.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bestätigungsdialog" Height="220" Width="480"
        Background="#101214"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False">
    <Border Background="#1E1F23" BorderBrush="#3A3D42" BorderThickness="1" CornerRadius="18" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Bestätigung" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock x:Name="MessageTextBlock" Grid.Row="1"
                       Text="Möchten Sie diese Aktion wirklich durchführen?"
                       Foreground="#D2D5DA"
                       Margin="0,0,0,22"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Ja" Width="110" Click="YesButton_Click" Margin="8,0,0,0" Background="#0078D4" Foreground="White" BorderBrush="#0078D4" BorderThickness="1" Height="42"/>
                <Button Content="Nein" Width="110" Click="NoButton_Click" Margin="8,0,0,0" Background="#2A2C31" Foreground="White" BorderBrush="#3A3D42" BorderThickness="1" Height="42"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
