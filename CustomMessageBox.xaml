<Window x:Class="BiMaDock.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bestätigungsdialog" Width="480"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">
    <Border Style="{DynamicResource DialogSurfaceBorderStyle}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE9CE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                           Foreground="#4CA0F0" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name=""/>
                <TextBlock Grid.Column="1" Text="Bestätigung" Style="{DynamicResource DialogTitleTextStyle}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="MessageTextBlock" Grid.Row="1"
                       Text="Möchten Sie diese Aktion wirklich durchführen?"
                       Style="{DynamicResource DialogBodyTextStyle}"
                       Margin="0,0,0,22"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="YesButton" Content="Ja" Style="{DynamicResource DialogPrimaryButtonStyle}" MinWidth="110" IsDefault="True" Click="YesButton_Click"/>
                <Button x:Name="NoButton" Content="Nein" Style="{DynamicResource DialogSecondaryButtonStyle}" MinWidth="110" IsCancel="True" Click="NoButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
